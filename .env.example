# Application port (Flask defaults to 5001 to prevent macOS AirPlay port 5000 conflicts)
PORT=5001

# LLM provider fallback order (comma-separated: groq, openrouter, gemini)
LLM_PROVIDERS=groq,openrouter,gemini

# Primary provider: Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Secondary provider: OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free

# Fallback provider: Google Gemini
GOOGLE_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Generation settings
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4000
LLM_TIMEOUT=15.0

# Security and logging
MAX_CONTENT_LENGTH=5242880
LOG_LEVEL=INFO
SECRET_KEY=change-this-to-a-secure-random-secret-in-production
